# Copy to .env and fill in. Same values as the website's .env.local, from
# Supabase Dashboard -> Project Settings -> API. EXPO_PUBLIC_ values ship inside the app,
# so never put the service role key or any other secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
